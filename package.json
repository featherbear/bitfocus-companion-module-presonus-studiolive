{
  "name": "bitfocus-presonus-studiolive",
  "version": "1.6.2",
  "scripts": {
    "build": "npm-run-all lint clean transpile",
    "transpile": "swc src -d dist --strip-leading-paths --config-file .swcrc --quiet",
    "clean": "rimraf dist pkg",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "package:dev": "companion-module-build --dev",
    "package": "companion-module-build"
  },
  "keywords": [
    "presonus",
    "studiolive"
  ],
  "main": "dist/index.js",
  "repository": "git@github.com:featherbear/bitfocus-companion-module-presonus-studiolive.git",
  "author": "Andrew Wong <andrew.j.wong@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "@companion-module/base": "^1.14.1",
    "@featherbear/presonus-studiolive-api": "^1.9.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@companion-module/tools": "^2.8.0",
    "@eslint/js": "^9.39.5",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
