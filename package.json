{
  "name": "bitfocus-presonus-studiolive",
  "version": "1.4.0",
  "scripts": {
    "build": "npm-run-all lint clean transpile",
    "transpile": "swc src -d dist --strip-leading-paths --config-file .swcrc --quiet",
    "clean": "rimraf dist pkg",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "package:dev": "companion-module-build --dev",
    "package": "companion-module-build"
  },
  "keywords": [
    "presonus",
    "studiolive"
  ],
  "main": "dist/index.js",
  "repository": "git@github.com:featherbear/bitfocus-companion-module-presonus-studiolive.git",
  "author": "Andrew Wong <andrew.j.wong@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "@companion-module/base": "^1.13.2",
    "nanoid": "^5.1.6",
    "presonus-studiolive-api": "github:featherbear/presonus-studiolive-api#v1.7.2"
  },
  "devDependencies": {
    "@companion-module/tools": "^2.4.1",
    "@eslint/js": "^9.38.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.18.12",
    "eslint": "^9.38.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}